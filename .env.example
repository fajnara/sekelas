# Tanpa DATABASE_URL, aplikasi berjalan sepenuhnya dari seed lokal di
# src/lib/data.js. Itu mode default: `npm run dev` langsung jalan setelah clone,
# dan harness fidelitas bisa berjalan di CI tanpa rahasia apa pun.
#
# Dengan DATABASE_URL, snapshot dibaca dari Postgres. Siapkan sekali dengan:
#   npm run db:seed
DATABASE_URL=

# Menandatangani cookie sandbox pengunjung. Hanya berpengaruh kalau DATABASE_URL
# terisi. Tanpa ini aplikasi tetap jalan, tapi cookie lama berhenti berlaku
# setiap deploy dan pengunjung mendapat sandbox baru.
SESSION_SECRET=

# Penyimpanan berkas untuk materi guru dan pengumpulan siswa. Tiga kemungkinan,
# dipilih dalam urutan ini:
#
#   1. SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY → Supabase Storage (produksi).
#      Buat bucket privat dengan file_size_limit 25 MB, lalu isi namanya di
#      SUPABASE_BUCKET (default "sekelas"). Batas di bucket itu yang menolak
#      berkas raksasa: klien mengunggah langsung ke Storage, jadi aplikasi baru
#      bisa membuangnya setelah sampai. Service role key **hanya** dibaca di
#      server; jangan pernah memberinya awalan NEXT_PUBLIC_.
#   2. STORAGE_DIR → folder biasa di disk. Untuk mencoba jalur unggahnya tanpa
#      akun cloud; tidak dipakai di produksi (filesystem Vercel sementara).
#   3. keduanya kosong → tidak ada penyimpanan: barisnya tetap tersimpan di
#      database, byte-nya dibuang. Ini mode default, dan `npm run dev` tetap
#      jalan.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
STORAGE_DIR=

# Menjaga route pembersihan berkala (`GET /api/cron`). Tanpa ini route-nya
# **mati** (503), bukan terbuka — ia menghapus data, dan `/api/*` di Vercel bisa
# diakses siapa saja. Vercel Cron mengirimkannya sendiri sebagai
# `Authorization: Bearer <CRON_SECRET>` kalau variabel ini terisi.
CRON_SECRET=

# Jam aplikasi dipatok ke Senin 7 September 2026 09.41 WIB supaya tampilannya
# tidak pernah menyimpang dari desain. Set "live" untuk memakai waktu asli —
# berguna untuk membuktikan logika waktunya nyata, bukan tabel label.
NEXT_PUBLIC_DEMO_CLOCK=
